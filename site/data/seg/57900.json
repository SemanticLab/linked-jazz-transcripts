{"id":57900,"ord":307,"n_segments":360,"prev":57899,"next":57901,"doc":{"id":"68251","title":"68251_Teddy McRae oral history interview","collection":"rutgers","inst":"Rutgers — Institute of Jazz Studies","interviewee":"Teddy McRae","interviewer":"","date":"","year":"","source_url":"https://rucore.libraries.rutgers.edu/rutgers-lib/68251/","url":"https://thisismattmiller.github.io/linked-jazz-2026-transcripts/?t=68251"},"chapter":"Bandleader, songwriter and record-label owner, 1946-81","title":"The Mr. Bear sessions for Groove","category":"recording_session","summary":"They sort out the Mr. Bear titles and the sidemen on the September and December 1955 RCA/Groove dates.","period":"1955","year_from":1955,"year_to":1955,"words":212,"start":[649,10],"end":[651,12],"url":"https://thisismattmiller.github.io/linked-jazz-2026-transcripts/?t=68251#s57900","tags":{"places":[],"venues":[],"bands":[{"name":"Mr. Bear","focus":1,"leader":"Teddy McRae"}]},"people":[{"name":"Hayward Henry","qid":null,"n":3},{"name":"Sam \"The Man\" Taylor","qid":"Q487099","n":2},{"name":"King Curtis","qid":"Q1345099","n":2},{"name":"Thomas Bear","qid":null,"n":1},{"name":"Milt Hinton","qid":"Q491411","n":1},{"name":"Mickey Baker","qid":"Q284459","n":1},{"name":"Teacho Wiltshire","qid":"Q113997294","n":1},{"name":"Dave McRae","qid":"Q64331027","n":1}],"story":{"theme":42,"theme_name":"In the studio: making records, then and now","community":98,"community_name":"My first record date: sessions, personnel, discography","core":false},"blocks":[{"p":649,"b":10,"s":"MR. MC RAE","x":"'I'm Gonna Keep My Good Eye On You.'"},{"p":649,"b":11,"s":"MR. WELBURN","x":"Yeah. 'I'm Gonna Keep My Good Eye On You,' 'How Come,' 'Peek-a-boo,' 'Mr. Bear Comes"},{"p":649,"b":12,"s":"","x":"S. & S. REPORTING COMPANY, INC. WOrth 2-2915 WOrth 2-2943"},{"p":650,"b":0,"s":"","x":"To Town \"--"},{"p":650,"b":1,"s":"MR. MC RAE","x":"Yeah."},{"p":650,"b":2,"s":"MR. WELBURN","x":"\"Radar\"--"},{"p":650,"b":3,"s":"MR. MC RAE","x":"Yeah."},{"p":650,"b":4,"s":"MR. WELBURN","x":"And the \"Bear Hug\"."},{"p":650,"b":5,"s":"MR. MC RAE","x":"Yeah."},{"p":650,"b":6,"s":"MR. WELBURN","x":"Now, on one of those --"},{"p":650,"b":7,"s":"MR. MC RAE","x":"Those are RCA on for Groove."},{"p":650,"b":8,"s":"MR. WELBURN","x":"Okay."},{"p":650,"b":9,"s":"MR. WELBURN","x":"Now on two of those -- it was September 20, 1955, Hayward Henry was on baritone. Teacher Wilshire on --"},{"p":650,"b":10,"s":"MR. MC RAE","x":"On piano."},{"p":650,"b":11,"s":"MR. WELBURN","x":"Mickey Baker on guitar, Milt Hinton and (inaudible) --"},{"p":650,"b":12,"s":"MR. MC RAE","x":"That was the first date."},{"p":650,"b":13,"s":"MR. WELBURN","x":"Okay. And 'Family Man' Taylor."},{"p":650,"b":14,"s":"MR. MC RAE","x":"That was the band I was telling you about, the all-star band."},{"p":650,"b":15,"s":"MR. WELBURN","x":"Okay."},{"p":650,"b":16,"s":"MR. MC RAE","x":"My brother, Dave McRae, on"},{"p":650,"b":17,"s":"","x":"S. & S. REPORTING COMPANY, INC. WOrth 2-2915 WOrth 2-2943"},{"p":651,"b":0,"s":"MR. WELBURN","x":"No, they list Hayward Henry."},{"p":651,"b":1,"s":"MR. MC RAE","x":"Hayward Henry did one of the dates, yeah."},{"p":651,"b":2,"s":"MR. WELBURN","x":"Okay. Now the second date, December 14, 1955, that's when you cut \"Peek-a-boo\" and so on."},{"p":651,"b":3,"s":"MR. MC RAE","x":"Um hum."},{"p":651,"b":4,"s":"MR. WELBURN","x":"They have Sam Taylor, King Curtis --"},{"p":651,"b":5,"s":"MR. MC RAE","x":"Yeah, King Curtis on tenor."},{"p":651,"b":6,"s":"MR. WELBURN","x":"You're playing baritone and also singing."},{"p":651,"b":7,"s":"MR. MC RAE","x":"No. My brother's playing baritone."},{"p":651,"b":8,"s":"MR. WELBURN","x":"Oh, then that's not you at all."},{"p":651,"b":9,"s":"MR. MC RAE","x":"I didn't play no instrument at all."},{"p":651,"b":10,"s":"MR. WELBURN","x":"Oh, I see."},{"p":651,"b":11,"s":"MR. MC RAE","x":"Because nobody -- the whole"},{"p":651,"b":12,"s":"","x":"S. & S. REPORTING COMPANY, INC. WOrth 2-2915 WOrth 2-2943"}]}