{"id":14546,"ord":3,"n_segments":88,"prev":14545,"next":14547,"doc":{"id":"alma9945593579906326","title":"Edward \"Kid\" Ory Interview, 1957-04-20","collection":"tulane","inst":"Tulane — Hogan Jazz Archive","interviewee":"Edward \"Kid\" Ory","interviewer":"Richard B. Allen","date":"1957-04-20","year":1957,"source_url":"https://library.search.tulane.edu/permalink/01TUL_INST/4h6sc4/alma9945593579906326","url":"https://thisismattmiller.github.io/linked-jazz-2026-transcripts/?t=alma9945593579906326"},"chapter":"Childhood in Laplace","title":"No musicians in the family; the Laplace and Reserve brass bands","category":"family_childhood","summary":"Nobody in his family played; he was drawn to the local brass bands.","period":"1890s","year_from":1890,"year_to":1899,"words":60,"start":[0,28],"end":[0,35],"url":"https://thisismattmiller.github.io/linked-jazz-2026-transcripts/?t=alma9945593579906326#s14546","tags":{"places":[{"name":"LaPlace","focus":1,"type":"city"},{"name":"Reserve","focus":1,"type":"city"}],"venues":[],"bands":[{"name":"Pickwick Brass Band","focus":1,"leader":null},{"name":"Arnold Brass Band","focus":1,"leader":null}]},"people":[],"story":{"theme":47,"theme_name":"Growing up and learning music: family, first instruments, teachers","community":117,"community_name":"Where I came from: parents, siblings and birth","core":true},"blocks":[{"p":0,"b":28,"s":"Richard B. Allen","x":"Were there any musicians in your family? No."},{"p":0,"b":29,"s":"Edward \"Kid\" Ory","x":"No."},{"p":0,"b":30,"s":"Richard B. Allen","x":"How come you became so interested in music?"},{"p":0,"b":31,"s":"Edward \"Kid\" Ory","x":"Well, I used to hear a brass band play all the time. Pickwick brass band and Arnold brass band."},{"p":0,"b":32,"s":"Richard B. Allen","x":"Those were bands from New Orleans, you mean?"},{"p":0,"b":33,"s":"Edward \"Kid\" Ory","x":"No, from one from Laplace."},{"p":0,"b":34,"s":"Richard B. Allen","x":"Oh."},{"p":0,"b":35,"s":"Edward \"Kid\" Ory","x":"And one from