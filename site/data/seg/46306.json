{"id":46306,"ord":1,"n_segments":189,"prev":46305,"next":46307,"doc":{"id":"56799","title":"56799_Red Norvo oral history interview","collection":"rutgers","inst":"Rutgers — Institute of Jazz Studies","interviewee":"Red Norvo","interviewer":"","date":"","year":"","source_url":"https://rucore.libraries.rutgers.edu/rutgers-lib/56799/","url":"https://thisismattmiller.github.io/linked-jazz-2026-transcripts/?t=56799"},"chapter":"Opening and boyhood in Beardstown","title":"Born in Beardstown, Illinois, in 1908","category":"family_childhood","summary":"Norvo gives his birth date and place and explains where Beardstown and Cass County sit on the Illinois River; Dance asks him to spell it out.","period":"1908","year_from":1908,"year_to":1908,"words":118,"start":[2,4],"end":[3,4],"url":"https://thisismattmiller.github.io/linked-jazz-2026-transcripts/?t=56799#s46306","tags":{"places":[{"name":"Beardstown","focus":1,"type":"city"},{"name":"Cass County","focus":1,"type":"region"},{"name":"Illinois","focus":1,"type":"state"},{"name":"Illinois River","focus":0,"type":"other"},{"name":"St. Louis","focus":0,"type":"city"},{"name":"Mississippi River","focus":0,"type":"other"},{"name":"Southern Illinois","focus":0,"type":"region"}],"venues":[],"bands":[]},"people":[],"story":{"theme":48,"theme_name":"Stating your name and birth date on tape","community":90,"community_name":"Opening the tape: name, birth date and birthplace","core":true},"blocks":[{"p":2,"b":4,"s":"MR. NORVO","x":"Well, I was born March 31st, 1908, and in Beardstown, Cass County, Illinois."},{"p":2,"b":5,"s":"MS. VANCE","x":"Beardstown, what? et sic"},{"p":2,"b":6,"s":"MR. NORVO","x":"Beardstown --"},{"p":2,"b":7,"s":"MS. VANCE","x":"Yeah?"},{"p":2,"b":8,"s":"MR. NORVO","x":"In Cass County --"},{"p":2,"b":9,"s":"MS. VANCE","x":"Cass County, is that C-a-s-s?"},{"p":2,"b":10,"s":"MR. NORVO","x":"That's Cass County --"},{"p":2,"b":11,"s":"MS. VANCE","x":"Yeah --"},{"p":2,"b":12,"s":"MR. NORVO","x":"It's in the State of Illinois."},{"p":2,"b":13,"s":"MS. VANCE","x":"Yeah --"},{"p":2,"b":14,"s":"MR. NORVO","x":"It's on the Illinois River."},{"p":2,"b":15,"s":"MS. VANCE","x":"I'm a foreigner, you know, so --"},{"p":2,"b":16,"s":"MR. NORVO","x":"It's on the Illinois River --"},{"p":2,"b":17,"s":"MS. VANCE","x":"Yeah."},{"p":2,"b":18,"s":"MR. NORVO","x":"Just about -- above St. Louis."},{"p":2,"b":19,"s":"MS. VANCE","x":"Good."},{"p":3,"b":0,"s":"MR. NORVO","x":"The Illinois River meets Mississippi at St. Louis --"},{"p":3,"b":1,"s":"MS. VANCE","x":"Oh --"},{"p":3,"b":2,"s":"MR. NORVO","x":"-- just above St. Louis."},{"p":3,"b":3,"s":"MS. VANCE","x":"Is that -- well that's not -- is that South? I mean in the sense is it southern country or it's real -- I mean --"},{"p":3,"b":4,"s":"MR. NORVO","x":"Not, it's just southern Illinois. Southern Illinois."}]}