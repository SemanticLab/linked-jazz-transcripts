{"id":48495,"ord":169,"n_segments":347,"prev":48494,"next":48496,"doc":{"id":"61529","title":"61529_Maxine Sullivan oral history interview","collection":"rutgers","inst":"Rutgers — Institute of Jazz Studies","interviewee":"Maxine Sullivan","interviewer":"","date":"","year":"","source_url":"https://rucore.libraries.rutgers.edu/rutgers-lib/61529/","url":"https://thisismattmiller.github.io/linked-jazz-2026-transcripts/?t=61529"},"chapter":"Jazz, style and Cliff Jackson","title":"Bronx bars and clubs: Jabbo's and the Band Box","category":"venue_city_scene","summary":"Campbell and Maxine place bars near Prospect Avenue and Boston Road where they sang or heard music.","period":"1940s-60s","year_from":1940,"year_to":2009,"words":140,"start":[414,4],"end":[415,10],"url":"https://thisismattmiller.github.io/linked-jazz-2026-transcripts/?t=61529#s48495","tags":{"places":[{"name":"Prospect Avenue","focus":1,"type":"street","in":"Bronx"},{"name":"Boston Road","focus":0,"type":"street","in":"Bronx"},{"name":"169th Street","focus":0,"type":"street","in":"Bronx"},{"name":"Freeman Street","focus":0,"type":"street","in":"Bronx"}],"venues":[{"name":"Band Box","focus":1,"city":"Bronx"},{"name":"Jabbo's Bar","focus":1,"city":"Bronx"}],"bands":[]},"people":[{"name":"Stokes","qid":null,"n":2},{"name":"Red Allen","qid":"Q1383538","n":1},{"name":"Kenny","qid":null,"n":1},{"name":"Francis","qid":null,"n":1}],"story":{"theme":36,"theme_name":"Coming to New York: clubs, jams, and making it","community":73,"community_name":"Making it in New York: arrival, clubs and the scene","core":false},"blocks":[{"p":414,"b":4,"s":"MR. CAMPBELL","x":"I'll tell you where else I used to sing with Kenny at the bar on (inaudible) Street, down in the basement."},{"p":414,"b":5,"s":"MS. SULLIVAN","x":"Right here, right around the corner."},{"p":414,"b":6,"s":"MR. CAMPBELL","x":"Right here, the cops used to hang out in the basement and they would send the food and whiskey down on the dumbwaiter."},{"p":414,"b":7,"s":"MS. SULLIVAN","x":"All right!"},{"p":414,"b":8,"s":"MR. CAMPBELL","x":"Did you know Stokes?"},{"p":414,"b":9,"s":"MS. SULLIVAN","x":"Yeah."},{"p":414,"b":10,"s":"MR. CAMPBELL","x":"Stokes and the guy who's Jabbo's Bar, Francis."},{"p":414,"b":11,"s":"MS. SULLIVAN","x":"That's right."},{"p":414,"b":12,"s":"","x":"S. & S. REPORTING COMPANY, INC. WOrth 2-2915 WOrth 2-2943"},{"p":415,"b":0,"s":"","x":"72"},{"p":415,"b":1,"s":"MR. HUGHES","x":"What's the location of that?"},{"p":415,"b":2,"s":"MR. CAMPBELL","x":"Jabbo's Bar, it's right over here on 169th Street and Prospect Avenue."},{"p":415,"b":3,"s":"MS. SULLIVAN","x":"And then the Band Box right on the corner of Freeman Street."},{"p":415,"b":4,"s":"MR. CAMPBELL","x":"Do a young lady still own the Band Box?"},{"p":415,"b":5,"s":"MS. SULLIVAN","x":"Yeah."},{"p":415,"b":6,"s":"MR. CAMPBELL","x":"What's her name?"},{"p":415,"b":7,"s":"MS. SULLIVAN","x":"I forget her name."},{"p":415,"b":8,"s":"MR. CAMPBELL","x":"Very dark woman, smooth complexion."},{"p":415,"b":9,"s":"MS. SULLIVAN","x":"Right, she's a very good friend of Red Allen's."},{"p":415,"b":10,"s":"MR. CAMPBELL","x":"Right, yeah."}]}