{"id":13443,"ord":4,"n_segments":50,"prev":13442,"next":13444,"doc":{"id":"alma9945593575506326","title":"Joe Loyacano Interview, 1959-08-20","collection":"tulane","inst":"Tulane — Hogan Jazz Archive","interviewee":"Joe Loyacano","interviewer":"Paul Crawford","date":"1959-08-20","year":1959,"source_url":"https://library.search.tulane.edu/permalink/01TUL_INST/4h6sc4/alma9945593575506326","url":"https://thisismattmiller.github.io/linked-jazz-2026-transcripts/?t=alma9945593575506326"},"chapter":"Beginnings and first bands","title":"His brothers Arnold, Jack and Bud and their instruments","category":"family_childhood","summary":"He names three musical brothers and what each played, including Jack the left-handed trombonist.","period":null,"year_from":null,"year_to":null,"words":85,"start":[0,27],"end":[0,38],"url":"https://thisismattmiller.github.io/linked-jazz-2026-transcripts/?t=alma9945593575506326#s13443","tags":{"places":[],"venues":[],"bands":[]},"people":[{"name":"Jack Loyacano","qid":null,"n":3},{"name":"Bud Loyacano","qid":null,"n":2},{"name":"Arnold Loyacano","qid":"Q15440425","n":2}],"story":{"theme":47,"theme_name":"Growing up and learning music: family, first instruments, teachers","community":117,"community_name":"Where I came from: parents, siblings and birth","core":true},"blocks":[{"p":0,"b":27,"s":"Paul Crawford","x":"And did anybody else in your family play music?"},{"p":0,"b":28,"s":"Joe Loyacano","x":"Yeah, my brothers played music. I had three brothers play music."},{"p":0,"b":29,"s":"Paul Crawford","x":"And what were their names?"},{"p":0,"b":30,"s":"Joe Loyacano","x":"Arnold, Jack. And Bud."},{"p":0,"b":31,"s":"Paul Crawford","x":"And what instruments did they play?"},{"p":0,"b":32,"s":"Joe Loyacano","x":"Well, Bud played mandolin. He played guitar. He played a little drum. He played a little bass. He played a little violin. Arnold played a little piano, bass, drum. Guitar, mandolin."},{"p":0,"b":33,"s":"Paul Crawford","x":"Jack, he played just..."},{"p":0,"b":34,"s":"Joe Loyacano","x":"Jack played trombone."},{"p":0,"b":35,"s":"Paul Crawford","x":"Was he left-handed?"},{"p":0,"b":36,"s":"Joe Loyacano","x":"Yeah, left-handed trombone player."},{"p":0,"b":37,"s":"Paul Crawford","x":"I've heard of him."},{"p":0,"b":38,"s":"Joe Loyacano","x":"Yeah."}]}