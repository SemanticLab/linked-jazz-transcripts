{"id":41714,"ord":119,"n_segments":144,"prev":41713,"next":41715,"doc":{"id":"52031","title":"52031_Kenny Clarke oral history interview","collection":"rutgers","inst":"Rutgers — Institute of Jazz Studies","interviewee":"Kenny Clarke","interviewer":"","date":"","year":"","source_url":"https://rucore.libraries.rutgers.edu/rutgers-lib/52031/","url":"https://semlab.io/linked-jazz-transcripts/?t=52031"},"chapter":"MJQ, Pettiford and the move to Paris","title":"Back in New York; Minton's again; meeting Milt Jackson","category":"band_or_employer","summary":"He worked with Stan Getz, then returned to Minton's, and recalls meeting Milt Jackson, Ray Brown and Joe Harris on 52nd Street with Dizzy's big band.","period":"1946; 1951","year_from":1946,"year_to":1951,"words":138,"start":[239,0],"end":[240,2],"url":"https://semlab.io/linked-jazz-transcripts/?t=52031#s41714","tags":{"places":[{"name":"52nd Street","focus":1,"type":"street","in":"New York"},{"name":"New York","focus":0,"type":"city"}],"venues":[{"name":"Minton's Playhouse","focus":1,"city":"New York"},{"name":"Spotlight","focus":0,"city":"New York"}],"bands":[{"name":"Milt Jackson Quartet","focus":1,"leader":"Milt Jackson"},{"name":"Dizzy Gillespie Orchestra","focus":0,"leader":"Dizzy Gillespie"}]},"people":[{"name":"Milt Jackson","qid":"Q435665","n":3},{"name":"Dizzy Gillespie","qid":"Q49575","n":2},{"name":"Teddy Hill","qid":"Q1530476","n":1},{"name":"Duke Jordan","qid":"Q1264406","n":1},{"name":"Ray Brown","qid":"Q354542","n":1},{"name":"Joe Harris","qid":"Q118521488","n":1},{"name":"Bill Crow","qid":"Q343903","n":1},{"name":"Stan Getz","qid":"Q30587","n":1}],"story":{"theme":5,"theme_name":"Charlie Parker, Dizzy and the bebop revolution","community":73,"community_name":"Making it in New York: arrival, clubs and the scene","core":false},"blocks":[{"p":239,"b":0,"s":"MS.","x":"Yeah."},{"p":239,"b":1,"s":"MR. CLARKE","x":"And I started out with -- well, I worked with Stan Getz, with Duke Jordan and Bill Crow on bass. Then I went back to Minton's."},{"p":239,"b":2,"s":"MS.","x":"Oh?"},{"p":239,"b":3,"s":"MR. CLARKE","x":"You know? And Teddy says, 'It's your joint. Do what you want.' So then we formed an MJQ, but it was the Milt Jackson Quartet."},{"p":239,"b":4,"s":"MS.","x":"Oh. Really?"},{"p":239,"b":5,"s":"MR. CLARKE","x":"And we had --"},{"p":239,"b":6,"s":"MS.","x":"When had you got to know Milt? Bags."},{"p":239,"b":7,"s":"MR. CLARKE","x":"Well, I knew Bags right after the war."},{"p":239,"b":8,"s":"MS.","x":"Yeah."},{"p":239,"b":9,"s":"MR. CLARKE","x":"He came to New York. Well, Diz had brought him to New York."},{"p":239,"b":10,"s":"MS.","x":"Oh."},{"p":239,"b":11,"s":"MR. CLARKE","x":"Along with Ray Brown."},{"p":239,"b":12,"s":"MS.","x":"Yeah."},{"p":239,"b":13,"s":"MR. CLARKE","x":"All these young kids."},{"p":239,"b":14,"s":"MS.","x":"Yeah."},{"p":239,"b":15,"s":"MR. CLARKE","x":"And Joe Harris, the drummer, you know."},{"p":239,"b":16,"s":"MS.","x":"Yeah."},{"p":239,"b":17,"s":"MR. CLARKE","x":"So I met them all on 52nd Street."},{"p":239,"b":18,"s":"MS.","x":"Yeah."},{"p":239,"b":19,"s":"MR. CLARKE","x":"Because we were working at the Spotlight"},{"p":240,"b":0,"s":"MR. CLARKE","x":"with Dizzy's big band."},{"p":240,"b":1,"s":"MS.","x":"I see."},{"p":240,"b":2,"s":"MR. CLARKE","x":"You know? So that's when I met Milt."}]}