{"id":56670,"ord":30,"n_segments":179,"prev":56669,"next":56671,"doc":{"id":"68154","title":"68154_Gus Johnson oral history interview","collection":"rutgers","inst":"Rutgers — Institute of Jazz Studies","interviewee":"Gus Johnson","interviewer":"","date":"","year":"","source_url":"https://rucore.libraries.rutgers.edu/rutgers-lib/68154/","url":"https://semlab.io/linked-jazz-transcripts/?t=68154"},"chapter":"Childhood in Tyler, Beaumont and Houston","title":"The Dewalts' standing and Mr. Dewalt's murder","category":"race_society","summary":"The Dewalts were among Houston's richest Black families; the father, president of the NAACP, was shot by his theatre operator, who was paid to do it and soon freed.","period":"1929","year_from":1929,"year_to":1929,"words":162,"start":[51,14],"end":[53,10],"url":"https://semlab.io/linked-jazz-transcripts/?t=68154#s56670","tags":{"places":[{"name":"Houston","focus":1,"type":"city"},{"name":"Texas","focus":0,"type":"state"}],"venues":[{"name":"Lincoln Theatre","focus":0,"city":"Houston"}],"bands":[]},"people":[{"name":"DeWalt (father of Olin Dewalt)","qid":null,"n":1}],"story":{"theme":47,"theme_name":"Growing up and learning music: family, first instruments, teachers","community":108,"community_name":"Growing up under segregation: schools, neighborhoods, Jim Crow","core":false},"blocks":[{"p":51,"b":14,"s":"MR. JOHNSON","x":"They were the richest black people in"},{"p":52,"b":0,"s":"MR. JOHNSON","x":"Houston."},{"p":52,"b":1,"s":"MS.","x":"Well, they owned the theatre. Were they, really?"},{"p":52,"b":2,"s":"MR. JOHNSON","x":"Yes."},{"p":52,"b":3,"s":"MS.","x":"Wasn't that -- your mother must have been well pleased."},{"p":52,"b":4,"s":"MR. JOHNSON","x":"Oh, yeah, she was."},{"p":52,"b":5,"s":"MS.","x":"Because you fell in good company."},{"p":52,"b":6,"s":"MR. JOHNSON","x":"Yes. He got killed, DeWalt."},{"p":52,"b":7,"s":"MS.","x":"Something unfortunate?"},{"p":52,"b":8,"s":"MR. JOHNSON","x":"Yes, he was head of the NAACP there."},{"p":52,"b":9,"s":"MS.","x":"You mean, the father?"},{"p":52,"b":10,"s":"MR. JOHNSON","x":"Yes, the father."},{"p":52,"b":11,"s":"MS.","x":"And he got killed?"},{"p":52,"b":12,"s":"MR. JOHNSON","x":"Yeah. His operator killed him. He was paid to kill him."},{"p":52,"b":13,"s":"MS.","x":"What do you mean, his operator?"},{"p":52,"b":14,"s":"MR. JOHNSON","x":"Operator of the theatre, movie house."},{"p":52,"b":15,"s":"MS.","x":"No."},{"p":52,"b":16,"s":"MR. JOHNSON","x":"That's right."},{"p":52,"b":17,"s":"MS.","x":"Was he white?"},{"p":52,"b":18,"s":"MR. JOHNSON","x":"No, he was black."},{"p":52,"b":19,"s":"MS.","x":"But he took money."},{"p":52,"b":20,"s":"MR. JOHNSON","x":"Yes, he did."},{"p":52,"b":21,"s":"MS.","x":"What a terrible thing."},{"p":53,"b":0,"s":"MR. JOHNSON","x":"That's right."},{"p":53,"b":1,"s":"MS.","x":"How old was he, about then? 50?"},{"p":53,"b":2,"s":"MR. JOHNSON","x":"I don't know how old."},{"p":53,"b":3,"s":"MS.","x":"And this was Houston."},{"p":53,"b":4,"s":"MR. JOHNSON","x":"Houston, Texas."},{"p":53,"b":5,"s":"MS.","x":"Well, what year do you think that would have been?"},{"p":53,"b":6,"s":"MR. JOHNSON","x":"Not -- that happened in -- after I had left Houston, 1929."},{"p":53,"b":7,"s":"MS.","x":"They shot him?"},{"p":53,"b":8,"s":"MR. JOHNSON","x":"Yes, they shot him."},{"p":53,"b":9,"s":"MS.","x":"Isn't that a terrible thing?"},{"p":53,"b":10,"s":"MR. JOHNSON","x":"Yes."}]}