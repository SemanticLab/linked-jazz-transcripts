{"id":61007,"ord":125,"n_segments":146,"prev":61006,"next":61008,"doc":{"id":"70980","title":"70980_Quinn Wilson oral history interview","collection":"rutgers","inst":"Rutgers — Institute of Jazz Studies","interviewee":"Quinn Wilson","interviewer":"","date":"","year":"","source_url":"https://rucore.libraries.rutgers.edu/rutgers-lib/70980/","url":"https://semlab.io/linked-jazz-transcripts/?t=70980"},"chapter":"Influences, later bands and reflections","title":"The illuminated glove at Jazz Limited","category":"later_career","summary":"Applause gesture during solos.","period":"1960s","year_from":1960,"year_to":1969,"words":89,"start":[180,9],"end":[181,5],"url":"https://semlab.io/linked-jazz-transcripts/?t=70980#s61007","tags":{"places":[{"name":"New Orleans","focus":0,"type":"city"}],"venues":[{"name":"Jazz Limited","focus":1,"city":"Chicago"}],"bands":[]},"people":[],"story":{"theme":10,"theme_name":"Band pranks, jokes and gigs gone wrong","community":17,"community_name":"Pranks, practical jokes and band humor","core":false},"blocks":[{"p":180,"b":9,"s":"MR. DE MICHAEL","x":"You had a little thing that you used to do with your hand at Jazz Limited, when you soloed."},{"p":180,"b":10,"s":"MR. WILSON","x":"When I applaud when I get through a solo?"},{"p":180,"b":11,"s":"MR. DE MICHAEL","x":"Yeah, unbelievable."},{"p":180,"b":12,"s":"MR. WILSON","x":"This left hand?"},{"p":181,"b":0,"s":"MR. DE MICHAEL","x":"Yeah."},{"p":181,"b":1,"s":"MR. WILSON","x":"Some fellow was here with a convention one time, and I think he was from New Orleans, or somewhere down South. Anyway, he gave me a left hand glove. It was illuminated, to use for that."},{"p":181,"b":2,"s":"MR. DE MICHAEL","x":"Really?"},{"p":181,"b":3,"s":"MR. WILSON","x":"Uh-huh."},{"p":181,"b":4,"s":"MR. DE MICHAEL","x":"Did you do it?"},{"p":181,"b":5,"s":"MR. WILSON","x":"Yeah, I used it. He said he brought it especially for \"Tiger Rag.\""}]}