{"id":317,"ord":0,"n_segments":26,"prev":null,"next":318,"doc":{"id":"alma9945523645506326","title":"De De Pierce Interview, 1960-01-10","collection":"tulane","inst":"Tulane — Hogan Jazz Archive","interviewee":"De De Pierce","interviewer":"Richard B. Allen","date":"1960-01-10","year":1960,"source_url":"https://library.search.tulane.edu/permalink/01TUL_INST/4h6sc4/alma9945523645506326","url":"https://semlab.io/linked-jazz-transcripts/?t=alma9945523645506326"},"chapter":"Opening and close","title":"Opening, date, location and names of those present","category":"interview_logistics","summary":"Recording set-up at De De Pierce's home on 10 January 1960; full names of those present are given.","period":null,"year_from":null,"year_to":null,"words":125,"start":[0,0],"end":[0,18],"url":"https://semlab.io/linked-jazz-transcripts/?t=alma9945523645506326#s317","tags":{"places":[{"name":"North Galvez Street","focus":1,"type":"street","in":"New Orleans"},{"name":"New Orleans","focus":0,"type":"city"}],"venues":[],"bands":[]},"people":[{"name":"Judith Donaldson Pearsall","qid":null,"n":3},{"name":"De De Pierce","qid":"Q5244336","n":3},{"name":"Billie Pierce","qid":"Q862845","n":2},{"name":"Ernest Selvich Rupania Senior","qid":null,"n":1}],"story":{"theme":51,"theme_name":"Starting the tape: names, dates and places","community":95,"community_name":"Interview openings: names, dates and tape setup","core":true},"blocks":[{"p":0,"b":0,"s":"Judith Donaldson Pearsall","x":"Would you rather sit here?"},{"p":0,"b":1,"s":"Richard B. Allen","x":"No, it doesn't matter. Let's see, we're recording this at 1619 North Galvest Street. And what's today's date, Didi?"},{"p":0,"b":2,"s":"De De Pierce","x":"The 10th."},{"p":0,"b":3,"s":"Richard B. Allen","x":"January the 10th, 1960."},{"p":0,"b":4,"s":"De De Pierce","x":"1960, right."},{"p":0,"b":5,"s":"Richard B. Allen","x":"And we're doing this in your home, it's in the back, huh, Didi?"},{"p":0,"b":6,"s":"De De Pierce","x":"Yeah, I see, in the back."},{"p":0,"b":7,"s":"Richard B. Allen","x":"And let's get your name down, your full name again."},{"p":0,"b":8,"s":"De De Pierce","x":"My full name? Joseph Lacroix Pierce."},{"p":0,"b":9,"s":"Richard B. Allen","x":"How do you spell Lacroix?"},{"p":0,"b":10,"s":"De De Pierce","x":"L-A-C-R-O-I-X."},{"p":0,"b":11,"s":"Richard B. Allen","x":"Is the L capitalized?"},{"p":0,"b":12,"s":"De De Pierce","x":"Yes."},{"p":0,"b":13,"s":"Richard B. Allen","x":"And the C?"},{"p":0,"b":14,"s":"De De Pierce","x":"No."},{"p":0,"b":15,"s":"Richard B. Allen","x":"No. Well, let's go around and get everybody's name. Billy? My name is Mrs. Willie Madison Pierce. And Ernest? My name's Ernest Selvich Rupania Senior. Okay."},{"p":0,"b":16,"s":"Judith Donaldson Pearsall","x":"My name's Judith Donaldson Pearsall."},{"p":0,"b":17,"s":"Richard B. Allen","x":"Gee, you speak softly, Judy."},{"p":0,"b":18,"s":"Judith Donaldson Pearsall","x":"Say it again. Judith Donaldson Pearsall. Okay."}]}