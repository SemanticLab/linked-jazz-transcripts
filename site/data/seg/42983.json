{"id":42983,"ord":22,"n_segments":151,"prev":42982,"next":42984,"doc":{"id":"52157","title":"52157_Count Basie oral history interview","collection":"rutgers","inst":"Rutgers — Institute of Jazz Studies","interviewee":"Count Basie","interviewer":"","date":"","year":"","source_url":"https://rucore.libraries.rutgers.edu/rutgers-lib/52157/","url":"https://thisismattmiller.github.io/linked-jazz-2026-transcripts/?t=52157"},"chapter":"Billie Holiday with the band (1971 session)","title":"Billie on managers, Herschel and Lester, and Freddie Green","category":"person_portrait","summary":"Basie sidesteps Billie's remark that he had too many managers, the Herschel Evans and Lester Young question, and what she said about Freddie Green.","period":"1937-38","year_from":1937,"year_to":1937,"words":168,"start":[34,7],"end":[35,20],"url":"https://thisismattmiller.github.io/linked-jazz-2026-transcripts/?t=52157#s42983","tags":{"places":[],"venues":[],"bands":[]},"people":[{"name":"Freddie Green","qid":"Q722441","n":2},{"name":"Billie Holiday","qid":"Q104358","n":1},{"name":"Lester Young","qid":"Q110714","n":1},{"name":"Herschel Evans","qid":"Q491395","n":1}],"story":{"theme":15,"theme_name":"Singers and the musicians who accompanied them","community":27,"community_name":"Billie Holiday as the musicians knew her","core":true},"blocks":[{"p":34,"b":7,"s":"MS.","x":"She said you weren't your own boss, that you had too many managers."},{"p":34,"b":8,"s":"","x":"(Laughter.)"},{"p":34,"b":9,"s":"","x":"Go ahead, challenge her."},{"p":34,"b":10,"s":"MR. BASIE","x":"No."},{"p":34,"b":11,"s":"MS.","x":"It's true?"},{"p":34,"b":12,"s":"MR. BASIE","x":"Whatever she said."},{"p":34,"b":13,"s":"MS.","x":"Herschel Evans, did he resent Lester because Billie wanted him to play behind her?"},{"p":34,"b":14,"s":"MR. BASIE","x":"Well, miss, I don't know. I think (inaudible) they has something going there."},{"p":34,"b":15,"s":"MS.","x":"How about Freddie Green?"},{"p":34,"b":16,"s":"","x":"(Laughter.)"},{"p":34,"b":17,"s":"MR. BASIE","x":"There he is."},{"p":34,"b":18,"s":"MS.","x":"All right, forget Freddie Green, right?"},{"p":35,"b":0,"s":"MR. BASIE","x":"What did they say?"},{"p":35,"b":1,"s":"MS.","x":"I'm not going to tell you."},{"p":35,"b":2,"s":"","x":"(Laughter.)"},{"p":35,"b":3,"s":"MR. BASIE","x":"Go on."},{"p":35,"b":4,"s":"MS.","x":"No, no, she was always real good on Freddie Green."},{"p":35,"b":5,"s":"MR. BASIE","x":"What did they say?"},{"p":35,"b":6,"s":"MS.","x":"Who?"},{"p":35,"b":7,"s":"MR. BASIE","x":"About Freddie."},{"p":35,"b":8,"s":"MS.","x":"Who, she? Oh, she just said she just loved him."},{"p":35,"b":9,"s":"MR. BASIE","x":"Uh-huh."},{"p":35,"b":10,"s":"MS.","x":"She didn't say very much."},{"p":35,"b":11,"s":"MR. BASIE","x":"Did she? She did, huh?"},{"p":35,"b":12,"s":"MS.","x":"She loved him, didn't she?"},{"p":35,"b":13,"s":"MR. BASIE","x":"You ain't going to tell -- you see?"},{"p":35,"b":14,"s":"","x":"(Laughter.)"},{"p":35,"b":15,"s":"MR. BASIE","x":"You see, you ain't going to let it hang out. You say you want me to tell it."},{"p":35,"b":16,"s":"","x":"(Laughter.)"},{"p":35,"b":17,"s":"MR. BASIE","x":"I ain't going to tell you nothing else."},{"p":35,"b":18,"s":"MS.","x":"I know you won't."},{"p":35,"b":19,"s":"","x":"(Laughter.)"},{"p":35,"b":20,"s":"","x":"(End of Tape One, Side A.)"}]}