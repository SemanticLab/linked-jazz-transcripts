{"id":47289,"ord":1,"n_segments":152,"prev":47288,"next":47290,"doc":{"id":"61125","title":"61125_Teddy Bunn oral history interview","collection":"rutgers","inst":"Rutgers — Institute of Jazz Studies","interviewee":"Theodore Leroy Bunn","interviewer":"","date":"","year":"","source_url":"https://rucore.libraries.rutgers.edu/rutgers-lib/61125/","url":"https://thisismattmiller.github.io/linked-jazz-2026-transcripts/?t=61125"},"chapter":"Long Island boyhood","title":"Birth and family roots on Long Island","category":"family_childhood","summary":"Bunn was born May 7, 1910 in Freeport, Long Island; both parents' families were long-time Long Islanders.","period":"1910","year_from":1910,"year_to":1910,"words":117,"start":[2,6],"end":[3,7],"url":"https://thisismattmiller.github.io/linked-jazz-2026-transcripts/?t=61125#s47289","tags":{"places":[{"name":"Freeport","focus":1,"type":"city","in":"Long Island"},{"name":"Long Island","focus":1,"type":"region"},{"name":"Rockville Center","focus":0,"type":"city","in":"Long Island"},{"name":"Westbury","focus":0,"type":"city","in":"Long Island"},{"name":"Hempstead","focus":0,"type":"city","in":"Long Island"}],"venues":[],"bands":[]},"people":[{"name":"Everett Arlington Bunn","qid":null,"n":1}],"story":{"theme":47,"theme_name":"Growing up and learning music: family, first instruments, teachers","community":117,"community_name":"Where I came from: parents, siblings and birth","core":false},"blocks":[{"p":2,"b":6,"s":"MR. ROSENBERG","x":"Let me see, from the beginning, then, you were born in Freeport, right?"},{"p":2,"b":7,"s":"MR. BUNN","x":"Freeport, Long Island."},{"p":2,"b":8,"s":"MR. ROSENBERG","x":"Long Island. And was that 1910, 1909?"},{"p":2,"b":9,"s":"MR. BUNN","x":"I was born in 1910."},{"p":2,"b":10,"s":"MR. ROSENBERG","x":"1910."},{"p":2,"b":11,"s":"MR. BUNN","x":"Uh-huh."},{"p":2,"b":12,"s":"MR. ROSENBERG","x":"And your family --"},{"p":2,"b":13,"s":"MR. BUNN","x":"May the 7th, 1910."},{"p":2,"b":14,"s":"MR. ROSENBERG","x":"May the 7th, 1910. And your family had been living around there for a there?"},{"p":2,"b":15,"s":"MR. BUNN","x":"Long Island, yeah. Rockville Center. Mother was born in Westbury, Long Island."},{"p":2,"b":16,"s":"MR. ROSENBERG","x":"So your family had been there --"},{"p":2,"b":17,"s":"MR. BUNN","x":"Yeah."},{"p":2,"b":18,"s":"MR. ROSENBERG","x":"-- for quite a while."},{"p":3,"b":0,"s":"MR. BUNN","x":"Yeah."},{"p":3,"b":1,"s":"MR. ROSENBERG","x":"From back in the 19th Century."},{"p":3,"b":2,"s":"MR. BUNN","x":"That's right."},{"p":3,"b":3,"s":"MR. ROSENBERG","x":"Do you know where they were from?"},{"p":3,"b":4,"s":"MR. ROSENBERG","x":"Farther back."},{"p":3,"b":5,"s":"MR. BUNN","x":"Let's see. Mother was born in Westbury, Long Island. My father was born in Hempstead."},{"p":3,"b":6,"s":"MR. ROSENBERG","x":"So they're really Long Islanders."},{"p":3,"b":7,"s":"MR. BUNN","x":"Yeah."}]}