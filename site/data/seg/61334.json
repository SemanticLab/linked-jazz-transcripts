{"id":61334,"ord":101,"n_segments":125,"prev":61333,"next":61335,"doc":{"id":"73243","title":"73243_Joe Thomas oral history interview","collection":"rutgers","inst":"Rutgers — Institute of Jazz Studies","interviewee":"Joe Thomas","interviewer":"","date":"","year":"","source_url":"https://rucore.libraries.rutgers.edu/rutgers-lib/73243/","url":"https://semlab.io/linked-jazz-transcripts/?t=73243"},"chapter":"Later 1930s: Bryant, Hopkins and Carter","title":"Joining Benny Carter at the Savoy","category":"band_or_employer","summary":"Thomas joined Benny Carter at the Savoy for about a year, wanting to stay in town, and made records including Sleep.","period":"1938-39","year_from":1938,"year_to":1938,"words":120,"start":[139,2],"end":[140,9],"url":"https://semlab.io/linked-jazz-transcripts/?t=73243#s61334","tags":{"places":[{"name":"Newport","focus":0,"type":"city"}],"venues":[{"name":"Savoy Ballroom","focus":1,"city":"New York"},{"name":"Carnegie Hall","focus":0,"city":"New York"}],"bands":[{"name":"Benny Carter Orchestra","focus":1,"leader":"Benny Carter"},{"name":"Claude Hopkins Orchestra","focus":0,"leader":"Claude Hopkins"},{"name":"Willie Bryant's band","focus":0,"leader":"Willie Bryant"}]},"people":[{"name":"Benny Carter","qid":"Q356715","n":6},{"name":"Claude Hopkins","qid":"Q362230","n":2},{"name":"Willy Bryant","qid":"Q730199","n":2},{"name":"Stanley Dance","qid":"Q741323","n":1}],"story":{"theme":18,"theme_name":"Getting paid: wages, tips and leaving over money","community":39,"community_name":"Battling at the Savoy Ballroom","core":false},"blocks":[{"p":139,"b":2,"s":"WD","x":"We must pass through now because we've got a few more things now. After Willy Bryant is Benny Carter next?"},{"p":139,"b":3,"s":"JT","x":"Claude Phil Hopkins is after Willy Bryant."},{"p":139,"b":4,"s":"WD","x":"Oh, yes, Claude Hopkins."},{"p":139,"b":5,"s":"JT","x":"Then Benny Carter."},{"p":139,"b":6,"s":"WD","x":"Well, how come you go with Benny?"},{"p":139,"b":7,"s":"JT","x":"Well, I want to stay in town and I'm happy to work with Benny."},{"p":139,"b":8,"s":"WD","x":"Where did he play?"},{"p":140,"b":0,"s":"","x":"JT (1 of 2) 40"},{"p":140,"b":1,"s":"JT","x":"The Savoy. So, the Savoy with Benny."},{"p":140,"b":2,"s":"WD","x":"How long does that last?"},{"p":140,"b":3,"s":"JT","x":"About a year, Stan."},{"p":140,"b":4,"s":"WD","x":"And then?"},{"p":140,"b":5,"s":"BT","x":"He did a few recordings with Benny. One of them was Sleep."},{"p":140,"b":6,"s":"JT","x":"And it came up in ..."},{"p":140,"b":7,"s":"WD","x":"That thing in Newport last year."},{"p":140,"b":8,"s":"JT","x":"Yeah, it came up in Carnegie Hall. The audience ..."},{"p":140,"b":9,"s":"WD","x":"It's a beautiful record."}]}