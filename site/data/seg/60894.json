{"id":60894,"ord":12,"n_segments":146,"prev":60893,"next":60895,"doc":{"id":"70980","title":"70980_Quinn Wilson oral history interview","collection":"rutgers","inst":"Rutgers — Institute of Jazz Studies","interviewee":"Quinn Wilson","interviewer":"","date":"","year":"","source_url":"https://rucore.libraries.rutgers.edu/rutgers-lib/70980/","url":"https://semlab.io/linked-jazz-transcripts/?t=70980"},"chapter":"Morton sessions and 1920s Chicago","title":"Johnny and Baby Dodds, and hearing King Oliver","category":"person_portrait","summary":"Wilson calls Johnny Dodds quiet and Baby jokey, heard Oliver at the Mahjong but never played with him.","period":"1920s","year_from":1920,"year_to":1929,"words":87,"start":[21,11],"end":[22,11],"url":"https://semlab.io/linked-jazz-transcripts/?t=70980#s60894","tags":{"places":[{"name":"Chicago","focus":0,"type":"city"}],"venues":[{"name":"Mahjong","focus":1,"city":"Chicago"},{"name":"Lincoln Gardens","focus":0,"city":"Chicago"},{"name":"Sunset Cafe","focus":0,"city":"Chicago"}],"bands":[{"name":"King Oliver's Creole Jazz Band","focus":1,"leader":"King Oliver"}]},"people":[{"name":"King Oliver","qid":"Q313368","n":4},{"name":"Baby Dodds","qid":"Q374629","n":2},{"name":"Johnny Dodds","qid":"Q498495","n":1}],"story":{"theme":35,"theme_name":"Remembering the early trumpeters and their styles","community":66,"community_name":"Remembering King Oliver: the man, the band, the decline","core":true},"blocks":[{"p":21,"b":11,"s":"MR. DE MICHAEL","x":"What kind of man was Johnny Dodds?"},{"p":21,"b":12,"s":"MR. WILSON","x":"Oh, he was wonderful. Nice and quiet."},{"p":22,"b":0,"s":"MR. DE MICHAEL","x":"What about Baby?"},{"p":22,"b":1,"s":"MR. WILSON","x":"Baby, well, he was the same way. Told a lot of jokes."},{"p":22,"b":2,"s":"MR. DE MICHAEL","x":"They were both in the Oliver Band, the Oliver Creole Jazz Band."},{"p":22,"b":3,"s":"MR. WILSON","x":"Yeah."},{"p":22,"b":4,"s":"MR. DE MICHAEL","x":"Did you ever hear that band?"},{"p":22,"b":5,"s":"MR. WILSON","x":"King Oliver?"},{"p":22,"b":6,"s":"MR. DE MICHAEL","x":"The King Oliver Jazz --"},{"p":22,"b":7,"s":"MR. WILSON","x":"Yes."},{"p":22,"b":8,"s":"MR. DE MICHAEL","x":"Where, at Lincoln Gardens?"},{"p":22,"b":9,"s":"MR. WILSON","x":"No, I heard them when they was at the Mahjong, across the street from Sunset."},{"p":22,"b":10,"s":"MR. DE MICHAEL","x":"Did you ever play with Oliver?"},{"p":22,"b":11,"s":"MR. WILSON","x":"No, I never worked with Oliver."}]}