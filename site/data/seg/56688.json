{"id":56688,"ord":48,"n_segments":179,"prev":56687,"next":56689,"doc":{"id":"68154","title":"68154_Gus Johnson oral history interview","collection":"rutgers","inst":"Rutgers — Institute of Jazz Studies","interviewee":"Gus Johnson","interviewer":"","date":"","year":"","source_url":"https://rucore.libraries.rutgers.edu/rutgers-lib/68154/","url":"https://thisismattmiller.github.io/linked-jazz-2026-transcripts/?t=68154"},"chapter":"Dallas high school years","title":"Kaiser Marshall and Debo Mills","category":"person_portrait","summary":"He thinks of Kaiser Marshall with Fletcher Henderson and of Debo Mills, whose place in Lloyd Hunter's band he later took.","period":"1930s","year_from":1930,"year_to":1939,"words":111,"start":[90,15],"end":[91,19],"url":"https://thisismattmiller.github.io/linked-jazz-2026-transcripts/?t=68154#s56688","tags":{"places":[],"venues":[],"bands":[{"name":"Lloyd Hunter's band","focus":0,"leader":"Lloyd Hunter"},{"name":"Horace Henderson's band","focus":0,"leader":"Horace Henderson"},{"name":"Fletcher Henderson Orchestra","focus":0,"leader":"Fletcher Henderson"}]},"people":[{"name":"Debo Mills","qid":null,"n":3},{"name":"Kaiser Marshall","qid":"Q1708374","n":3},{"name":"Lloyd Hunter","qid":"Q4797599","n":2},{"name":"Horace Henderson","qid":"Q1627876","n":2}],"story":{"theme":14,"theme_name":"Drummers and drumming: who played what, and how","community":42,"community_name":"Great drummers: who they admired and why","core":true},"blocks":[{"p":90,"b":15,"s":"MR. JOHNSON","x":"And I was thinking about the drummers. Kaiser was with --"},{"p":90,"b":16,"s":"MR. JOHNSON","x":"Yeah, Kaiser Marshall."},{"p":91,"b":0,"s":"","x":"Kaiser"},{"p":91,"b":1,"s":"MS.","x":"Keyser Marshall was with Fletcher."},{"p":91,"b":2,"s":"MR. JOHNSON","x":"Right."},{"p":91,"b":3,"s":"MS.","x":"But Horace was always changing personnel all the time."},{"p":91,"b":4,"s":"MR. JOHNSON","x":"Yeah, like, Debo Mills was with Lloyd Hunter's band."},{"p":91,"b":5,"s":"MS.","x":"Oh?"},{"p":91,"b":6,"s":"MR. JOHNSON","x":"So when he left, --"},{"p":91,"b":7,"s":"MS.","x":"How do you spell Debo Mills?"},{"p":91,"b":8,"s":"MR. JOHNSON","x":"D-e-b-o."},{"p":91,"b":9,"s":"MS.","x":"That's a funny name."},{"p":91,"b":10,"s":"MR. JOHNSON","x":"They --"},{"p":91,"b":11,"s":"MS.","x":"He was a drummer."},{"p":91,"b":12,"s":"MR. JOHNSON","x":"He was a drummer."},{"p":91,"b":13,"s":"MS.","x":"And he was with Lloyd Hunter?"},{"p":91,"b":14,"s":"MR. JOHNSON","x":"Yeah, he played with Lloyd Hunter's band before he got with Horace."},{"p":91,"b":15,"s":"MS.","x":"Oh, I see. And you took his place, huh?"},{"p":91,"b":16,"s":"MR. JOHNSON","x":"I took his place."},{"p":91,"b":17,"s":"MS.","x":"Yeah."},{"p":91,"b":18,"s":"MR. JOHNSON","x":"His name was Debo -- yeah, Debo Mills."},{"p":91,"b":19,"s":"MS.","x":"Doesn't matter, that's close enough."}]}