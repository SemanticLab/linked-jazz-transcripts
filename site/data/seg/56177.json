{"id":56177,"ord":97,"n_segments":178,"prev":56176,"next":56178,"doc":{"id":"68099","title":"68099_Erskine Hawkins oral history interview","collection":"rutgers","inst":"Rutgers — Institute of Jazz Studies","interviewee":"Erskine Hawkins","interviewer":"","date":"","year":"","source_url":"https://rucore.libraries.rutgers.edu/rutgers-lib/68099/","url":"https://semlab.io/linked-jazz-transcripts/?t=68099"},"chapter":"Compositions, singers and the end of the big band","title":"Goines and Hawkins run through the band's vocalists","category":"band_or_employer","summary":"They name Ruth Christian, Lu Elliott, Madeline Green, Carline Ray, Effie Smith and Merle Washington.","period":"1930s-50s","year_from":1930,"year_to":1989,"words":230,"start":[154,3],"end":[157,2],"url":"https://semlab.io/linked-jazz-transcripts/?t=68099#s56177","tags":{"places":[{"name":"Birmingham","focus":0,"type":"city"},{"name":"California","focus":0,"type":"state"}],"venues":[],"bands":[]},"people":[{"name":"Ruth Christian","qid":null,"n":2},{"name":"Madeline Green","qid":null,"n":2},{"name":"Frosina Hargrove","qid":null,"n":2},{"name":"Lu Elliott","qid":"Q22959063","n":2},{"name":"Merle Washington","qid":null,"n":2},{"name":"Billy Daniels","qid":"Q4912425","n":1},{"name":"Della Reese","qid":"Q238361","n":1},{"name":"DeLores Brown","qid":null,"n":1},{"name":"Dolly Lyons","qid":null,"n":1},{"name":"Effie Smith","qid":"Q21069507","n":1},{"name":"Carline Ray","qid":"Q1041734","n":1},{"name":"Rioht","qid":null,"n":1},{"name":"The name","qid":null,"n":1}],"story":{"theme":15,"theme_name":"Singers and the musicians who accompanied them","community":28,"community_name":"Band singers and accompanying vocalists","core":true},"blocks":[{"p":154,"b":3,"s":"MR. GOINES","x":"Yeah. Anybody else that we haven't thought of that functioned as vocalist at that time?"},{"p":154,"b":4,"s":"MR. HAWKINS","x":"Yeah. I got a couple"},{"p":155,"b":0,"s":"MR. HAWKINS","x":"of girls. I'm trying to recall the names but, if I can get to them."},{"p":155,"b":1,"s":"MR. HAWKINS","x":"Well, it may come up a little later for me. I can't recall, but there's two other girls that I had."},{"p":155,"b":2,"s":"MR. GOINES","x":"Okay. Delores Brown, Della Reese, Billy Daniels, Ruth Christian."},{"p":155,"b":3,"s":"MR. HAWKINS","x":"That's one I was trying to think of."},{"p":155,"b":4,"s":"MR. GOINES","x":"Okay."},{"p":155,"b":5,"s":"MR. HAWKINS","x":"Ruth Christian."},{"p":155,"b":6,"s":"MR. GOINES","x":"Lu Elliott?"},{"p":155,"b":7,"s":"MR. HAWKINS","x":"That's the other one!"},{"p":155,"b":8,"s":"MR. GOINES","x":"Lu Elliott. That's the one."},{"p":155,"b":9,"s":"MR. GOINES","x":"Okay. Madeline Green."},{"p":155,"b":10,"s":"MR. HAWKINS","x":"Rioht! I admit, I forgot about Madeline. Right. Sure."},{"p":155,"b":11,"s":"MR. HAWKINS","x":"Madeline Green was quite a while with me."},{"p":155,"b":12,"s":"MR. GOINES","x":"Frosina Hargrove."},{"p":155,"b":13,"s":"MR. HAWKINS","x":"Who's this? Right. Now I've got to think about her. I don't know how long she was with me. I'm trying to place"},{"p":156,"b":0,"s":"MR. GOINES","x":"Right."},{"p":156,"b":1,"s":"MR. HAWKINS","x":"The name, the name come to me."},{"p":156,"b":2,"s":"MR. GOINES","x":"Right."},{"p":156,"b":3,"s":"MR. HAWKINS","x":"Right. But, she wasn't too long with me."},{"p":156,"b":4,"s":"MR. GOINES","x":"Frosina Hargrove."},{"p":156,"b":5,"s":"MR. HAWKINS","x":"Right. Dolly Lyons."},{"p":156,"b":6,"s":"MR. HAWKINS","x":"Right. I called her."},{"p":156,"b":7,"s":"MR. GOINES","x":"Carline Ray."},{"p":156,"b":8,"s":"MR. HAWKINS","x":"Right. Played guitar and piano."},{"p":156,"b":9,"s":"MR. GOINES","x":"Right."},{"p":156,"b":10,"s":"MR. HAWKINS","x":"Right. She was, see, I missed a few names."},{"p":156,"b":11,"s":"MR. GOINES","x":"Effie Smith?"},{"p":156,"b":12,"s":"MR. HAWKINS","x":"That's the one from California."},{"p":156,"b":13,"s":"MR. GOINES","x":"Okay."},{"p":156,"b":14,"s":"MR. HAWKINS","x":"I brought her from California."},{"p":156,"b":15,"s":"MR. GOINES","x":"All right."},{"p":157,"b":0,"s":"MR. HAWKINS","x":"You got some other, you got another name on that?"},{"p":157,"b":1,"s":"MR. GOINES","x":"Merle Turner? Merle Washington?"},{"p":157,"b":2,"s":"MR. HAWKINS","x":"From Birmingham! I brought her from Birmingham here. She stayed not too far from me. She's the one that did 'I Got A Right To Cry'."}]}